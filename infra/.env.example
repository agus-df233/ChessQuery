# Variables de los servicios en local (docker compose levanta la infra; los servicios corren con Maven)
DB_URL=jdbc:postgresql://localhost:5432/chessquery
DB_USER=chessquery
DB_PASSWORD=chessquery

# Bus SNS/SQS y S3 locales (LocalStack). El SDK de AWS toma estas variables sin cambios de código;
# en la nube no existen: región por la task y credenciales por el rol IAM.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
CHESS_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:chess-events

# Entra External ID (tenant CIAM). Google entra federado por este mismo tenant.
OIDC_ISSUER_URI=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
OIDC_AUDIENCE=<client-id-de-la-api>

# Secreto compartido para /internal/** entre servicios (SSM Parameter Store en cloud)
INTERNAL_TOKEN=dev-internal-token
