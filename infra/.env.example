# Variables de los servicios en local (docker compose levanta la infra; los servicios corren con Maven)
DB_URL=jdbc:postgresql://localhost:5432/chessquery
DB_USER=chessquery
DB_PASSWORD=chessquery
RABBITMQ_HOST=localhost
RABBITMQ_USER=chessquery
RABBITMQ_PASSWORD=chessquery

# Entra External ID (tenant CIAM). Google entra federado por este mismo tenant.
OIDC_ISSUER_URI=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
OIDC_AUDIENCE=<client-id-de-la-api>

# Secreto compartido para /internal/** entre servicios (Secrets Manager en cloud)
INTERNAL_TOKEN=dev-internal-token
