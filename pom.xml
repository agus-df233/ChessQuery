<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>cl.chessquery</groupId>
  <artifactId>chessquery</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ChessQuery</name>
  <description>Plataforma de ajedrez competitivo: servicios Java, ETL Python, web React</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jacoco.version>0.8.13</jacoco.version>
    <jacoco.minimum>0.90</jacoco.minimum>
    <spring-cloud-aws.version>3.4.2</spring-cloud-aws.version>
    <jib.version>3.4.5</jib.version>
    <!-- Solo los servicios generan imagen; las libs (y el pom raíz) la saltan. -->
    <jib.skip>true</jib.skip>
    <!-- Imagen: se sobreescribe en CD con -Dimage=<ecr>/chessquery/<servicio>:<tag> -->
    <image>chessquery/${project.artifactId}:${project.version}</image>
  </properties>

  <modules>
    <module>libs/common</module>
    <module>libs/auth-starter</module>
    <module>services/users</module>
    <module>services/tournament</module>
    <module>services/game</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- SNS/SQS/S3 (ADR-0002). La línea 3.4.x es la compatible con Spring Boot 3.5. -->
      <dependency>
        <groupId>io.awspring.cloud</groupId>
        <artifactId>spring-cloud-aws-dependencies</artifactId>
        <version>${spring-cloud-aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>cl.chessquery</groupId>
        <artifactId>chessquery-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cl.chessquery</groupId>
        <artifactId>chessquery-auth-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Desde JDK 23 javac no ejecuta procesadores del classpath si no se declaran: Lombok
             va explícito para compilar igual en JDK 21 (CI) y en JDKs más nuevos (local). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <!-- Imágenes OCI sin Dockerfile, multi-arch (Fargate ARM64 en la nube, amd64 en CI).
             Local: mvn -pl services/<svc> -am -DskipTests package jib:dockerBuild -->
        <plugin>
          <groupId>com.google.cloud.tools</groupId>
          <artifactId>jib-maven-plugin</artifactId>
          <version>${jib.version}</version>
          <configuration>
            <from>
              <image>eclipse-temurin:21-jre</image>
              <platforms>
                <platform><architecture>arm64</architecture><os>linux</os></platform>
                <platform><architecture>amd64</architecture><os>linux</os></platform>
              </platforms>
            </from>
            <to>
              <image>${image}</image>
            </to>
            <container>
              <user>1000:1000</user>
              <jvmFlags>
                <jvmFlag>-XX:MaxRAMPercentage=75</jvmFlag>
              </jvmFlags>
            </container>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <executions>
            <execution>
              <goals><goal>prepare-agent</goal></goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>test</phase>
              <goals><goal>report</goal></goals>
            </execution>
            <execution>
              <id>check</id>
              <phase>test</phase>
              <goals><goal>check</goal></goals>
              <configuration>
                <rules>
                  <rule>
                    <element>BUNDLE</element>
                    <limits>
                      <limit>
                        <counter>LINE</counter>
                        <value>COVEREDRATIO</value>
                        <minimum>${jacoco.minimum}</minimum>
                      </limit>
                    </limits>
                  </rule>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
