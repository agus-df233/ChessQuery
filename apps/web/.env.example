# Solo para apuntar la web a un tenant real de Entra. Para trabajar en local NO hace falta:
# `make dev` levanta la web con el IdP simulado y no lee este archivo.
# Copiar a apps/web/.env (ignorado por git) y completar con los datos del tenant (guía de configuración de Entra).

# Entra External ID (tenant CIAM). Google entra federado por este tenant.
VITE_OIDC_AUTHORITY=https://<tenant>.ciamlogin.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=<client-id-de-la-spa>
# Scope de la API: expuesto en el app registration de la API (api://<client-id-api>/access)
VITE_OIDC_SCOPE=openid profile email offline_access api://<client-id-api>/access
# Base de la API. Vacío = mismo origen (proxy de Vite en local, API Gateway/ALB en la nube)
VITE_API_URL=
# WebSocket de las partidas en vivo (salida `ws_url` de Terraform). Vacío = solo long polling.
VITE_WS_URL=
